{
  "name": "workbench-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "我的工作台桌面端（Tauri 封装）+ Cloudflare Pages Functions 后端",
  "scripts": {
    "build": "node scripts/build-pages.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "pages:dev": "npm run build:pages && wrangler pages dev _site"
  },
  "dependencies": {
    "jose": "^6.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260730.1",
    "@tauri-apps/cli": "^2",
    "typescript": "^5.9.2",
    "wrangler": "^4.28.0"
  }
}

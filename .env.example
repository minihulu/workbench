# ========= 我的工作台 · 生产配置模板 =========
# 用法：复制本文件为 .env 再改值
#   cp .env.example .env
#   nano .env
# docker compose 会自动读取同目录的 .env 并注入容器（变量替换 ${VAR}）。
# 注意：.env 含密钥，已被 .gitignore 忽略，切勿提交！

# —— 域名与证书（必改）——
# 你的域名，A 记录必须已解析到这台服务器公网 IP
DOMAIN=workbench.example.com
# Let's Encrypt 注册邮箱（证书到期提醒 + 账户）
EMAIL=you@example.com

# —— 注册策略（给别人用建议：关公开注册 + 邀请码）——
REGISTER_OPEN=0
REGISTER_REQUIRE_INVITE=1
# 初始邀请码，逗号分隔；分发给你要邀请的人，用过的会自动标记失效
INVITE_CODES=wb-aaa,wb-bbb,wb-ccc

# —— 安全 ——
# 管理后台口令，务必改成随机长串（否则 /api/admin/* 不开启）
ADMIN_TOKEN=please-change-me-to-a-long-random-string

# —— GitHub 搜索（可选）——
# 个人访问令牌，提额到 5000/h；不填也能用（匿名 10/min）
GH_TOKEN=
# 服务器出网代理（若直连 GitHub 被墙），例如 http://127.0.0.1:7890
GH_PROXY=

# —— LLM 语义重排（可选，留空即关闭 /api/search/rerank）——
# 搜索到结果后，用 LLM 按「功能是否满足需求」重排并给出「为什么匹配」。
# 不配置时前端自动降级为关键词匹配模式，关键词搜索完全不受影响。
LLM_API_KEY=
# OpenAI 兼容 Chat Completions 端点（默认 DeepSeek 国内直连，不走 GitHub 代理）
LLM_BASE_URL=https://api.deepseek.com/v1
# 模型名（DeepSeek 用 deepseek-chat）
LLM_MODEL=deepseek-chat
# 服务端超时秒（默认 10；前端 8s，务必保持 服务端 >= 前端，否则降级条会先触发）
LLM_TIMEOUT=10
# 显式指定出网代理才生效（如 http://127.0.0.1:7890）；留空 = LLM_OPENER 强制直连
LLM_PROXY=
# SSRF 白名单：前端 X-LLM-Base 仅当命中此列表才生效，逗号分隔。
# ⚠️ 只填你信任的 LLM 端点，任何多余 URL 都可能被恶意前端当转发器探内网。
LLM_ALLOWED_BASES=https://api.deepseek.com/v1,https://api.openai.com/v1,https://dashscope.aliyuncs.com/compatible-mode/v1,https://api.moonshot.cn/v1,https://api.siliconflow.cn/v1

# —— 备份 ——
# 自动备份间隔秒（默认 21600=6h），0 关闭
BACKUP_INTERVAL=21600

# —— 存储后端：Supabase（可选，Phase 2 混合架构）——
# 留空 SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY → 自动回退本地 SQLite（零依赖，开箱即用）。
# 两项都填 → 自动启用 Supabase（Auth + Postgres jsonb 存储），无需改代码。
# 显式设 STORAGE_BACKEND=sqlite 可强制回退（迁移期一键回滚兜底）。
# 注意：服务端一律用 SERVICE_ROLE_KEY；ANON_KEY 仅做登录口令校验，绝不下发前端。
# WORKBENCH_JWT_SECRET 为自签 JWT 密钥（独立 HS256，务必 32+ 位随机串，勿复用 SUPABASE_JWT_SECRET）。
STORAGE_BACKEND=supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_REGION=ap-southeast-1
WORKBENCH_JWT_SECRET=
# 周期 JSON 导出（Supabase 模式的备份，替代 SQLite 文件复制）保留份数
BACKUP_KEEP=7

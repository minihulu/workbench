sequenceDiagram
    actor U as 用户
    participant ST as SelectionToolbar(showSelToolbar)
    participant DL as DictLoader
    participant IDB as IndexedDB
    participant TS as TranslateService
    participant H as server.py Handler
    participant RL as RateLimiter
    participant LM as LLM(llm_chat/LLM_OPENER)
    participant DS as DeepSeek

    U->>ST: 选中 PDF 文字
    ST->>ST: 显示浮层(高亮/评论/想法/复制/✕ + 🔍查词 + 🌐翻译)
    alt 点击 🔍查词（本地，离线可用）
        ST->>DL: lookupWord(word)
        DL->>DL: ensureLoaded() 懒加载 vendor/ecdict.min.js
        DL->>IDB: 缓存/读取 window.ECDICT
        DL-->>ST: {word,phonetic,pos,meaning} | null
        ST->>ST: showDictPop(锚点) / 未命中提示
    else 点击 🌐翻译(四六级) 或 settings.autoTranslate=true
        ST->>TS: callTranslate(selectedText, "cet4/6")
        TS->>H: POST /api/ai/translate {text, level}
        H->>RL: allow("tr:" + client_ip)
        alt 限流
            RL-->>H: (false, retry)
            H-->>TS: 429 {error}
        else 通过
            H->>LM: llm_chat(base, key, model, messages, timeout)
            LM->>DS: chat/completions
            DS-->>LM: content
            LM-->>H: translation
            H-->>TS: 200 {ok:true, translation, level}
        end
        TS->>ST: showTrPop(锚点, 译文 / 降级提示)
    end

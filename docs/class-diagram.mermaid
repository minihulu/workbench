classDiagram
    class DictLoader {
        +ECDICT: object
        +ensureLoaded() Promise~void~
        +lookupWord(word) DictEntry
    }
    class SelectionToolbar {
        +showSelToolbar(rect, draft) void
        +bindPdfSelection(pagesEl, b) void
        +onDict() void
        +onTranslate() void
    }
    class TranslateService {
        +callTranslate(text, level) Promise~TrResult~
        -showTrPop(anchor, res) void
    }
    class Settings {
        +get(key) any
        +set(key, val) void
        +autoTranslate: bool
    }
    class CogHome {
        +renderCogHome() void
    }
    class Handler {
        +do_POST() void
        +api_ai_translate(body) void
    }
    class RateLimiter {
        +allow(key) (bool, int)
    }
    class LLM {
        <<reused from server.py>>
        +llm_chat(base, key, model, messages, timeout) string
        +LLM_OPENER: opener
        +LLM_API_KEY: string
        +LLM_MODEL: string
    }
    SelectionToolbar ..> DictLoader : 查词(本地)
    SelectionToolbar ..> TranslateService : 翻译(AI)
    SelectionToolbar ..> Settings : 读 autoTranslate
    CogHome ..> Settings : 读写开关
    CogHome ..> SelectionToolbar : 英语助手入口
    TranslateService ..> Handler : POST /api/ai/translate
    Handler ..> RateLimiter : 限流
    Handler ..> LLM : llm_chat

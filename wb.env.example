# ===================================================================
# 我的工作台 —— 配置模板（Docker / 本地通用）
# ===================================================================
# 用法（本地 exe）：把本文件复制为 wb.env，改完重启「我的工作台.exe」即生效。
# 用法（Docker）：复制为 wb.env，在 docker-compose.yml 打开 env_file 或挂卷那两行。
# 规则：KEY=VALUE，一行一个；# 开头是注释；值不用加引号。
#       如果系统/compose 里已经设了同名环境变量，会以环境变量为准。
#
# 本文件只含占位，无真实密钥，可放心提交到仓库；真正填值的 wb.env 已被忽略。
# ===================================================================


# ------------------- QQ 登录 -------------------
# 申请入口：https://connect.qq.com  →  应用管理  →  创建应用  →  网站应用
# 拿到 APP ID 和 APP Key 后填到下面两行（去掉行首的 #）
# 回调地址在 QQ 互联后台要填：http://127.0.0.1:8000/api/auth/qq/callback
#
# QQ_APP_ID=你的APPID
# QQ_APP_SECRET=你的APPKey


# ------------------- 微信登录 -------------------
# 申请入口：https://open.weixin.qq.com  →  管理中心  →  网站应用  →  创建应用
# 注意：微信网站应用只对「企业」开放，个人开发者无法申请（详见下方说明）
# 回调地址填：http://127.0.0.1:8000/api/auth/wechat/callback
#
# WECHAT_APP_ID=你的AppID
# WECHAT_APP_SECRET=你的AppSecret


# ------------------- GitHub 搜索 -------------------
# 不填也能用（匿名 10 次/分钟）；填了提升到 5000 次/小时。
# 申请：https://github.com/settings/tokens  →  Generate new token (classic)
#       不需要勾任何权限，纯提额度用
# GH_TOKEN=ghp_xxxxxxxxxxxx

# 代理（一般会自动识别系统代理，识别不到时手动填）
# GH_PROXY=http://127.0.0.1:7890


# ------------------- 给别人用时的开关 -------------------
# 关闭公开注册（只有你能登录）
# REGISTER_OPEN=0

# 开启邀请码注册
# REGISTER_REQUIRE_INVITE=1
# INVITE_CODES=code-aaa,code-bbb,code-ccc

# 管理后台令牌（设了才能访问 /api/admin/*）
# ADMIN_TOKEN=改成一段只有你知道的随机字符串


# ------------------- 其他 -------------------
# 端口（默认 8000，被占用会自动往后找）
# PORT=8000

# 自动备份间隔秒数（默认 21600 = 6 小时，设 0 关闭）
# BACKUP_INTERVAL=21600


# ------------------- 翻译 / 语义重排 大模型（可选） -------------------
# 英语助手「🌐翻译」与 GitHub 语义重排共用同一套 LLM。不填则翻译接口返回
# {ok:false, fallback:true, reason:"llm_not_configured"}，前端静默降级，不影响其他功能。
# 推荐用 DeepSeek（国内直连，server.py 已为其单独开 LLM_OPENER，不继承系统代理）。
#
# 必填：你的 API Key（也可在前端「设置」里用 X-LLM-Token 自带 Key，即 BYOK）
# LLM_API_KEY=sk-xxxxxxxxxxxx
#
# 兼容 OpenAI 的 base（默认已是 DeepSeek，一般不用改）
# LLM_BASE_URL=https://api.deepseek.com/v1
#
# 模型名（默认 deepseek-chat）
# LLM_MODEL=deepseek-chat
#
# 单次超时秒数（默认 10，需 >= 前端等待；翻译内容短，10s 足够）
# LLM_TIMEOUT=10
#
# 仅当走代理才能访问 LLM 时才填（国内直连 DeepSeek 留空即可）
# LLM_PROXY=http://127.0.0.1:7890
#
# 允许前端用 X-LLM-Base 指定的 base 白名单（逗号分隔；SSRF 防护，不在名单内直接忽略）
# LLM_ALLOWED_BASES=https://api.deepseek.com/v1,https://api.openai.com/v1,https://dashscope.aliyuncs.com/compatible-mode/v1,https://api.moonshot.cn/v1,https://api.siliconflow.cn/v1

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "我的工作台",
  "version": "0.1.0",
  "identifier": "com.workbench.app",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://localhost:8000",
    "beforeBuildCommand": "",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "我的工作台",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../server.py": "server.py",
      "../workbench.html": "workbench.html",
      "../index.html": "index.html"
    },
    "windows": {
      "wix": {
        "language": "zh-CN"
      },
      "nsis": {
        "languages": ["SimpChinese"]
      }
    }
  }
}
